# =============================================================================
# .gitignore for the HRM mechanistic-interpretability fork
# =============================================================================

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
.env

# IDE / editor
.vscode/
.idea/
*.swp

# Large model / numerical artefacts
*.pt
*.ckpt
*.pth
*.npy
*.npz
*.tar.gz
*.run

# Data / outputs / experiment artefacts (large)
data/
outputs/
wandb/
logs/
checkpoints/

# Per-puzzle logs that should not be committed
experiments/paper_replication/results/easy_hard_analysis/results.json


# PDFs (paper/figures excepted above)
docs/*.pdf
*.log

# Private assistant state - must never be published
.claude/

# Per-example prediction dumps from evaluate.py (~4.4 GB each, regenerable)
*_all_preds.*

# Activation caches and SAE sweep snapshots (multi-GB, regenerable on GPU)
results/**/activations_*.pt
results/**/sae_d*_epoch*.pt

# Raw per-example records; the committed aggregate.json is the reported artefact
results/**/per_puzzle.jsonl
results/**/per_pair.jsonl
results/**/per_direction_results.json
results/**/results_per_puzzle.jsonl
results/Sudoku/hamming_multi/*.csv
results/Maze/reports/*.html

# Local release staging
artifacts/
